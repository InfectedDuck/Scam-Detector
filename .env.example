# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=saqbol
# Use a URL-safe random value, e.g. Python secrets.token_hex(32).
POSTGRES_PASSWORD=
POSTGRES_DB=saqbol
# For Python commands outside Compose, set the same credentials in this URL.
DATABASE_URL=

# --- LLM providers (see docs/06_DAY0_CHECKLIST.md section C) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Cloud International (Qwen3, Qwen-VL)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Screenshot reader. Blank means qwen3-vl-flash; qwen3-vl-plus reads harder images.
SAQBOL_VISION_MODEL=

# OpenRouter (GPT-4o-mini, Llama — leaderboard only, not the hot path)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Which model the bot and the API ask. The leaderboard varies this per run.
SAQBOL_MODEL=deepseek-flash
# Recorded model responses, so a rerun costs nothing and every number is traceable.
SAQBOL_LLM_CACHE_DIR=.cache/llm

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Where the bot keeps language choices and daily counters (a JSON file).
BOT_STATE_PATH=.state/bot.json

# --- Security ---
# Used to HMAC telegram user ids and IPs. Raw identifiers are never stored.
ACTOR_HASH_SECRET=change_me_to_32_random_bytes

# --- Behaviour ---
DAILY_CHECK_LIMIT=10
MAX_TEXT_CHARS=8000
MAX_IMAGE_BYTES=5242880
TEXT_RETENTION_DAYS=30

# --- HTTP API ---
# Comma-separated browser origins allowed to call the API. Empty means none.
CORS_ORIGINS=
# Set to 1 only behind a proxy you control (Cloudflare, nginx); then the first
# X-Forwarded-For address is the client for rate limiting.
TRUST_PROXY=0

# --- Web app (web/.env.local) ---
# Base URL of the API. Unset means the web app serves mock verdicts.
SAQBOL_API_BASE=http://127.0.0.1:8000
# Public origin, used for absolute share links and Open Graph images.
SAQBOL_SITE_URL=
# Cloudflare Turnstile, shown after the third check in a browser session.
# Both blank means no challenge at all; the API's daily limit still applies.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
