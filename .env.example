# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=saqbol
POSTGRES_PASSWORD=change_me
POSTGRES_DB=saqbol
DATABASE_URL=postgresql+psycopg://saqbol:change_me@localhost:5432/saqbol

# --- LLM providers (see docs/06_DAY0_CHECKLIST.md section C) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Cloud International (Qwen3, Qwen-VL)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenRouter (GPT-4o-mini, Llama — leaderboard only, not the hot path)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Security ---
# Used to HMAC telegram user ids and IPs. Raw identifiers are never stored.
ACTOR_HASH_SECRET=change_me_to_32_random_bytes

# --- Behaviour ---
DAILY_CHECK_LIMIT=10
MAX_TEXT_CHARS=8000
MAX_IMAGE_BYTES=5242880
TEXT_RETENTION_DAYS=30
